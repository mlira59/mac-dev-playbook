---
# Secrets Template for mac-dev-playbook
# Copy this to group_vars/all/vault.yml and encrypt with ansible-vault
#
# Usage:
#   mkdir -p group_vars/all
#   cp secrets.yml.example group_vars/all/vault.yml
#   ansible-vault encrypt group_vars/all/vault.yml
#
# Or use: make vault-create

# Sudo password for privilege escalation
vault_ansible_become_password: "YOUR_SUDO_PASSWORD"

# Mac App Store credentials (optional - only if using mas role)
vault_mas_email: ""
vault_mas_password: ""

# GitHub token for private repos (optional)
vault_github_token: ""

# Any additional secrets can be added here
# vault_my_api_key: ""
